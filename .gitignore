target/
# Scratch space: downloaded games, extracted folders, one-off probes.
tmp/
*.wasm
# The demo ships the module its payloads run on; everything else under `dist/`
# stays out of the repository.
!demo/payloads/*/host_wasm.wasm
demo-site/node_modules/
__pycache__/
*.pyc
.DS_Store
release/
# A built payload: the module plus the game's own files, which the kit never owns.
dist/
# Payloads whose files are not the repository's to ship. `local/payloads/<slug>/`
# holds them, `local/payloads/index.json` describes them, and `demo-site/serve.ts`
# serves them to this machine only. One rule, no game named here: the published
# tree (`demo/payloads/`) is the only one that ships, and it never contains one.
local/
